# Normaliza finales de linea: LF en el repo, nativo al hacer checkout.
* text=auto

*.kt      text eol=lf
*.kts     text eol=lf
*.xml     text eol=lf
*.pro     text eol=lf
*.md      text eol=lf
*.properties text eol=lf
gradlew   text eol=lf
*.bat     text eol=crlf
*.jar     binary
*.png     binary
*.jks     binary
*.keystore binary
